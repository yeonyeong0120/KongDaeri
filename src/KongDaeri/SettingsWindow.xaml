<Window x:Class="KongDaeri.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:KongDaeri.Converters"
        Title="콩대리 설정"
        Icon="Assets/kongdr_glasses_icon.ico"
        Width="520" SizeToContent="Height"
        FontFamily="{StaticResource AppFont}"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <StackPanel Margin="18">

        <!-- Gemini API 키 -->
        <TextBlock Text="Gemini API 키" FontWeight="SemiBold"/>
        <Grid Margin="0,4,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <PasswordBox x:Name="GeminiPw" Grid.Column="0" Height="28" VerticalContentAlignment="Center"
                         Visibility="{Binding ShowGeminiKey, Converter={StaticResource BoolToVis}, ConverterParameter=invert}"/>
            <TextBox x:Name="GeminiTb" Grid.Column="0" Height="28" VerticalContentAlignment="Center"
                     Visibility="{Binding ShowGeminiKey, Converter={StaticResource BoolToVis}}"/>
            <ToggleButton Grid.Column="1" Content="👁" Width="34" Height="28" Margin="6,0,0,0"
                          IsChecked="{Binding ShowGeminiKey}" ToolTip="보기/숨기기"/>
        </Grid>
        <TextBlock Text="{Binding GeminiKeyStatus}" FontSize="11" Foreground="#FF777777" Margin="0,2,0,0"/>

        <!-- Notion 토큰 -->
        <TextBlock Text="Notion 토큰" FontWeight="SemiBold" Margin="0,14,0,0"/>
        <Grid Margin="0,4,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <PasswordBox x:Name="NotionPw" Grid.Column="0" Height="28" VerticalContentAlignment="Center"
                         Visibility="{Binding ShowNotionToken, Converter={StaticResource BoolToVis}, ConverterParameter=invert}"/>
            <TextBox x:Name="NotionTb" Grid.Column="0" Height="28" VerticalContentAlignment="Center"
                     Visibility="{Binding ShowNotionToken, Converter={StaticResource BoolToVis}}"/>
            <ToggleButton Grid.Column="1" Content="👁" Width="34" Height="28" Margin="6,0,0,0"
                          IsChecked="{Binding ShowNotionToken}" ToolTip="보기/숨기기"/>
        </Grid>
        <TextBlock Text="{Binding NotionTokenStatus}" FontSize="11" Foreground="#FF777777" Margin="0,2,0,0"/>

        <!-- Notion 페이지 ID (비밀 아님) -->
        <TextBlock Text="Notion 페이지 ID" FontWeight="SemiBold" Margin="0,14,0,0"/>
        <TextBox Height="28" Margin="0,4,0,0" VerticalContentAlignment="Center"
                 Text="{Binding NotionPageIdInput, UpdateSourceTrigger=PropertyChanged}"/>

        <!-- 스니퍼 단축키 -->
        <TextBlock Text="스니퍼 단축키 (예: Ctrl+Alt+S)" FontWeight="SemiBold" Margin="0,14,0,0"/>
        <TextBox Height="28" Margin="0,4,0,0" VerticalContentAlignment="Center"
                 Text="{Binding SnipHotkeyInput, UpdateSourceTrigger=PropertyChanged}"/>

        <!-- 번역 기본 언어 -->
        <TextBlock Text="번역 기본 언어" FontWeight="SemiBold" Margin="0,14,0,0"/>
        <ComboBox Height="28" Margin="0,4,0,0" VerticalContentAlignment="Center"
                  ItemsSource="{Binding Languages}"
                  SelectedItem="{Binding TranslateLanguageInput, Mode=TwoWay}"/>

        <!-- 안내 -->
        <TextBlock Text="키/토큰을 비워두고 저장하면 기존 값이 유지됩니다."
                   FontSize="11" Foreground="#FF999999" TextWrapping="Wrap" Margin="0,14,0,0"/>

        <!-- 위험 영역 -->
        <Border BorderBrush="#FFE0B4B4" BorderThickness="1" CornerRadius="6"
                Padding="10" Margin="0,16,0,0">
            <StackPanel>
                <TextBlock Text="위험 구역" FontWeight="SemiBold" Foreground="#FFC62828"/>
                <TextBlock Text="수집함의 모든 항목과 스니핑 이미지를 영구 삭제합니다. (설정/키는 유지)"
                           FontSize="11" Foreground="#FF777777" TextWrapping="Wrap" Margin="0,2,0,8"/>
                <Button Content="모든 수집 데이터 삭제" HorizontalAlignment="Left"
                        Padding="12,6" Foreground="White" Background="#FFC62828"
                        BorderBrush="#FFB71C1C" Click="OnClearAll"/>
            </StackPanel>
        </Border>

        <!-- 버튼 -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="저장" Width="80" Height="30" Margin="0,0,8,0" Click="OnSave"/>
            <Button Content="취소" Width="80" Height="30" Click="OnCancel"/>
        </StackPanel>
    </StackPanel>
</Window>
