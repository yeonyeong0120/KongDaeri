<Window x:Class="KongDaeri.CollectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:KongDaeri.Converters"
        Title="콩대리 수집함"
        Icon="Assets/kongdr_glasses_icon.ico"
        Height="580" Width="940"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <conv:NullToVisibilityConverter x:Key="NullToVis"/>
    </Window.Resources>

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="330"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 상단 바: 설정 버튼 -->
        <Button Grid.Row="0" Grid.Column="1" Content="설정" Width="70" Padding="0,4"
                HorizontalAlignment="Right" Margin="0,0,0,6"
                Command="{Binding OpenSettingsCommand}"/>

        <!-- ===== 왼쪽: 수집 항목 리스트 ===== -->
        <ListView Grid.Row="1" Grid.Column="0"
                  ItemsSource="{Binding Items}"
                  SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Padding" Value="4"/>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- 썸네일(이미지 항목만) -->
                        <Border Grid.Column="0" Width="44" Height="44" Margin="0,0,8,0"
                                Visibility="{Binding HasImage, Converter={StaticResource BoolToVis}}">
                            <Image Source="{Binding ImagePath}" Stretch="UniformToFill"/>
                        </Border>

                        <!-- 제목 + 시각/출처 -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock FontSize="11" Foreground="#FF777777">
                                <Run Text="{Binding CapturedAtText, Mode=OneWay}"/>
                                <Run Text=" · "/>
                                <Run Text="{Binding SourceText, Mode=OneWay}"/>
                            </TextBlock>
                        </StackPanel>

                        <!-- 상태 배지 -->
                        <Border Grid.Column="2" VerticalAlignment="Center"
                                Background="{Binding StatusBrush}"
                                CornerRadius="8" Padding="6,2" Margin="6,0,0,0">
                            <TextBlock Text="{Binding StatusText}" FontSize="11"
                                       Foreground="White"/>
                        </Border>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- ===== 오른쪽: 상세 ===== -->
        <Grid Grid.Row="1" Grid.Column="1" Margin="12,0,0,0">

            <!-- 선택 없음 안내 -->
            <TextBlock Text="왼쪽에서 항목을 선택하세요"
                       Foreground="#FF999999" FontSize="14"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Visibility="{Binding SelectedItem, Converter={StaticResource NullToVis}, ConverterParameter=invert}"/>

            <!-- 상세 패널 -->
            <DockPanel Visibility="{Binding SelectedItem, Converter={StaticResource NullToVis}}">

                <!-- 헤더: 제목 + 상태 -->
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <TextBlock Text="{Binding SelectedItem.Title}" FontSize="18" FontWeight="Bold"
                               TextWrapping="Wrap"/>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <Border Background="{Binding SelectedItem.StatusBrush}" CornerRadius="8" Padding="8,2">
                            <TextBlock Text="{Binding SelectedItem.StatusText}" Foreground="White" FontSize="11"/>
                        </Border>
                        <TextBlock Text="{Binding SelectedItem.CapturedAtText}" Foreground="#FF777777"
                                   FontSize="12" VerticalAlignment="Center" Margin="8,0,0,0"/>
                        <TextBlock Text="{Binding SelectedItem.SourceText}" Foreground="#FF777777"
                                   FontSize="12" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- 액션 버튼 -->
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                            HorizontalAlignment="Right" Margin="0,8,0,0">
                    <Button Content="AI 정리" Command="{Binding ProcessAiCommand}"
                            Padding="14,6" Margin="0,0,8,0"/>
                    <Button Content="노션 공유" Command="{Binding ShareCommand}"
                            Padding="14,6" Margin="0,0,8,0"/>
                    <Button Content="삭제" Command="{Binding DeleteCommand}"
                            Padding="14,6" Foreground="#FFC62828"/>
                </StackPanel>

                <!-- 원본 / AI 결과 (위아래) -->
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 원본 -->
                    <GroupBox Grid.Row="0" Header="원본" Margin="0,0,0,6">
                        <Grid>
                            <!-- 이미지 원본 -->
                            <Image Source="{Binding SelectedItem.ImagePath}" Stretch="Uniform"
                                   Visibility="{Binding SelectedItem.HasImage, Converter={StaticResource BoolToVis}}"/>
                            <!-- 텍스트 원본 -->
                            <TextBox Text="{Binding SelectedItem.RawText, Mode=OneWay}"
                                     IsReadOnly="True" TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     BorderThickness="0" Background="Transparent"
                                     Visibility="{Binding SelectedItem.IsTextOriginal, Converter={StaticResource BoolToVis}}"/>
                        </Grid>
                    </GroupBox>

                    <!-- AI 결과 -->
                    <GroupBox Grid.Row="1" Header="AI 정리 결과">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Margin="0,0,0,4">
                                <Run Text="태그: " FontWeight="SemiBold"/>
                                <Run Text="{Binding SelectedItem.AiTagsText, Mode=OneWay}"/>
                            </TextBlock>
                            <TextBox Text="{Binding SelectedItem.AiMarkdown, Mode=OneWay}"
                                     IsReadOnly="True" TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     FontFamily="Consolas" BorderThickness="0" Background="Transparent"/>
                        </DockPanel>
                    </GroupBox>
                </Grid>
            </DockPanel>
        </Grid>
    </Grid>
</Window>
